# Copy to .env (or export in your shell). All optional.
PORT=20128
HOST=127.0.0.1
# Protect the dashboard / admin API (strongly recommended if HOST is not 127.0.0.1)
ADMIN_PASSWORD=
# Extra router key accepted by /v1 endpoints (in addition to keys created in the dashboard)
ROUTER_API_KEY=
# Provider keys (comma-separate several keys to rotate between them)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
NVIDIA_API_KEY=
